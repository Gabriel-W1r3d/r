// Ohm Player - professional responsive UI.
// Layout: left sidebar (nav) + top search bar + page area + persistent player bar.
// Pages: 0 = Home, 1 = Search, 2 = Library, 3 = Settings, 4 = History.

import { ListView, LineEdit } from "std-widgets.slint";

// ============================= Theme =============================

export global Theme {
    out property <color> bg: #0c0d12;
    out property <color> surface: #14161d;
    out property <color> surface2: #1b1e28;
    out property <color> surface3: #252938;
    out property <color> stroke: #2b3040;
    out property <color> text: #eef0f6;
    out property <color> muted: #8a90a3;
    out property <color> accent: #8b5cf6;
    out property <color> accent2: #22d3ee;
}

// ============================= Data structs =============================

export struct SongItem {
    title: string,
    artist: string,
    album: string,
    path: string,
    is-voice: bool,
}

export struct PlaylistItem {
    id: int,
    name: string,
    cover: image,
    song-count: int,
}

export struct AlbumItem {
    name: string,
    artist: string,
    count: int,
    cover: image,
}

export struct ArtistItem {
    name: string,
    count: int,
}

export struct ScrobbleItem {
    title: string,
    artist: string,
    album: string,
    date: string,
    time: string,
}

export struct StatItem {
    name: string,
    count: int,
    ratio: float,
}

export struct QueueItem {
    title: string,
    artist: string,
    playing: bool,
}

// ============================= Small building blocks =============================

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <length> size: 36px;
    in property <length> icon-size: 15px;
    in property <bool> active: false;
    in property <string> tip: "";
    callback clicked;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: ta.has-hover ? Theme.surface3 : transparent;
    animate background { duration: 120ms; }
    Text {
        width: 100%;
        height: 100%;
        text: root.icon;
        color: root.active ? Theme.accent : Theme.text;
        font-size: root.icon-size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked;
    height: 30px;
    width: txt.preferred-width + 30px;
    border-radius: 15px;
    background: root.active ? Theme.accent : Theme.surface2;
    border-width: 1px;
    border-color: root.active ? Theme.accent : Theme.stroke;
    animate background { duration: 120ms; }
    txt := Text {
        width: 100%;
        height: 100%;
        text: root.label;
        color: root.active ? #ffffff : Theme.muted;
        font-size: 12px;
        font-weight: root.active ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

component SectionTitle inherits Text {
    font-size: 17px;
    font-weight: 700;
    color: Theme.text;
}

// Small statistics card (Last.fm style).
component StatCard inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> icon;
    height: 86px;
    border-radius: 14px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.stroke;
    HorizontalLayout {
        padding: 16px;
        spacing: 12px;
        Text {
            text: root.icon;
            font-size: 22px;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.value;
                color: Theme.text;
                font-size: 22px;
                font-weight: 800;
            }
            Text {
                text: root.label;
                color: Theme.muted;
                font-size: 11px;
            }
        }
    }
}

// Ranked row with a horizontal play-count bar (Last.fm style).
component TopRow inherits Rectangle {
    in property <int> rank;
    in property <string> name;
    in property <int> count;
    in property <float> ratio;
    in property <color> bar-color: Theme.accent;
    height: 40px;
    HorizontalLayout {
        spacing: 10px;
        Text {
            text: root.rank;
            color: Theme.muted;
            font-size: 12px;
            font-weight: 700;
            width: 18px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            Text {
                text: root.name;
                color: Theme.text;
                font-size: 12px;
                font-weight: 600;
                overflow: elide;
            }
            Rectangle {
                height: 5px;
                border-radius: 2.5px;
                background: Theme.surface3;
                Rectangle {
                    x: 0;
                    y: 0;
                    width: max(parent.width * root.ratio, 5px);
                    height: parent.height;
                    border-radius: 2.5px;
                    background: root.bar-color;
                }
            }
        }
        Text {
            text: root.count;
            color: Theme.accent2;
            font-size: 12px;
            font-weight: 700;
            width: 30px;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
}

// Horizontal slider (value 0..1). The value is owner-driven: dragging only
// emits `changed`; the owner updates `value`, keeping the binding intact.
component HSlider inherits Rectangle {
    in property <float> value: 0;
    in property <color> fill: Theme.accent;
    callback changed(float);
    height: 16px;
    function apply(mx: length) {
        root.changed(max(0.0, min(1.0, mx / root.width)));
    }
    ta := TouchArea {
        clicked => { root.apply(self.mouse-x); }
        moved => {
            if (self.pressed) { root.apply(self.mouse-x); }
        }
    }
    Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        width: 100%;
        border-radius: 2px;
        background: Theme.surface3;
        Rectangle {
            x: 0;
            y: 0;
            height: 100%;
            width: parent.width * root.value;
            border-radius: 2px;
            background: root.fill;
        }
    }
    Rectangle {
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: #ffffff;
        x: max(0px, min(root.width - 12px, root.width * root.value - 6px));
        y: (parent.height - 12px) / 2;
        visible: ta.has-hover || ta.pressed;
    }
}

// Vertical slider (value 0..1, bottom = 0). Owner-driven like HSlider.
component VSlider inherits Rectangle {
    in property <float> value: 0.5;
    callback changed(float);
    width: 40px;
    function apply(my: length) {
        root.changed(max(0.0, min(1.0, 1.0 - my / root.height)));
    }
    ta := TouchArea {
        clicked => { root.apply(self.mouse-y); }
        moved => {
            if (self.pressed) { root.apply(self.mouse-y); }
        }
    }
    Rectangle {
        x: (parent.width - 5px) / 2;
        width: 5px;
        height: 100%;
        border-radius: 2.5px;
        background: Theme.surface3;
        Rectangle {
            x: 0;
            width: 100%;
            y: parent.height * (1.0 - root.value);
            height: parent.height * root.value;
            border-radius: 2.5px;
            background: @linear-gradient(180deg, #22d3ee 0%, #8b5cf6 100%);
        }
    }
    Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #ffffff;
        x: (parent.width - 16px) / 2;
        y: max(0px, min(root.height - 16px, root.height * (1.0 - root.value) - 8px));
    }
}

// Cover image with gradient fallback.
component CoverBox inherits Rectangle {
    in property <image> cover;
    in property <string> glyph: "♪";
    clip: true;
    background: @linear-gradient(135deg, #303652 0%, #191c28 100%);
    if root.cover.width > 0: Image {
        width: 100%;
        height: 100%;
        source: root.cover;
        image-fit: ImageFit.cover;
    }
    if root.cover.width == 0: Text {
        width: 100%;
        height: 100%;
        text: root.glyph;
        color: #5b628050;
        font-size: root.height * 0.34;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active: false;
    in property <bool> expanded: true;
    callback clicked;
    height: 44px;
    border-radius: 10px;
    background: root.active ? Theme.surface3 : (ta.has-hover ? Theme.surface2 : transparent);
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: root.expanded ? 14px : 0px;
        spacing: 12px;
        Text {
            text: root.icon;
            font-size: 17px;
            color: root.active ? Theme.accent : Theme.muted;
            vertical-alignment: center;
            horizontal-alignment: root.expanded ? left : center;
            width: root.expanded ? 22px : root.width;
        }
        if root.expanded: Text {
            text: root.label;
            font-size: 14px;
            font-weight: root.active ? 700 : 500;
            color: root.active ? Theme.text : Theme.muted;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A small toggle switch.
component Toggle inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled(bool);
    width: 46px;
    height: 26px;
    border-radius: 13px;
    background: root.checked ? Theme.accent : Theme.surface3;
    animate background { duration: 140ms; }
    Rectangle {
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: #ffffff;
        y: 3px;
        x: root.checked ? root.width - 23px : 3px;
        animate x { duration: 140ms; easing: ease-out; }
    }
    TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// Row used in song lists.
component SongRow inherits Rectangle {
    in property <int> index;
    in property <string> title;
    in property <string> subtitle;
    in property <string> trailing: "";
    in property <bool> voice-badge: false;
    callback play;
    height: 52px;
    border-radius: 8px;
    background: ta.has-hover ? Theme.surface2 : transparent;
    ta := TouchArea {
        clicked => { root.play(); }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        Rectangle {
            width: 28px;
            if !ta.has-hover: Text {
                width: 100%;
                height: 100%;
                text: root.index + 1;
                color: Theme.muted;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if ta.has-hover: Text {
                width: 100%;
                height: 100%;
                text: "▶";
                color: Theme.accent;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 600;
                    overflow: elide;
                }
                if root.voice-badge: Rectangle {
                    width: 40px;
                    height: 16px;
                    border-radius: 8px;
                    background: #22d3ee22;
                    Text {
                        width: 100%;
                        height: 100%;
                        text: "VOZ";
                        color: Theme.accent2;
                        font-size: 9px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            Text {
                text: root.subtitle;
                color: Theme.muted;
                font-size: 11px;
                overflow: elide;
            }
        }
        Text {
            text: root.trailing;
            color: Theme.muted;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-alignment: right;
            width: 160px;
            overflow: elide;
            visible: root.width > 560px;
        }
    }
}

// ============================= Main window =============================

export component AppWindow inherits Window {
    title: "Ohm Player";
    min-width: 860px;
    min-height: 580px;
    preferred-width: 1200px;
    preferred-height: 760px;
    background: Theme.bg;
    default-font-family: "Segoe UI";

    // ---------- Navigation state ----------
    in-out property <int> active-page: 0;        // 0 home, 1 search, 2 library, 3 settings, 4 history
    in-out property <int> library-tab: 0;        // 0 playlists, 1 songs, 2 albums, 3 artists
    in-out property <int> sort-mode: 0;          // 0 A-Z, 1 recently added, 2 recently played
    in-out property <bool> queue-open: false;

    // ---------- Home ----------
    in property <[PlaylistItem]> recent-playlists: [];
    in property <[SongItem]> recent-songs: [];

    // ---------- Search ----------
    in-out property <int> search-filter: 0;      // 0 all, 1 music, 2 voice
    in property <[SongItem]> search-results: [];

    // ---------- Library ----------
    in property <[PlaylistItem]> playlists: [];
    in property <[SongItem]> library-songs: [];
    in property <[AlbumItem]> albums: [];
    in property <[ArtistItem]> artists: [];
    in-out property <int> selected-playlist-id: -1;
    in property <string> selected-playlist-name: "";
    in property <image> selected-playlist-cover;
    in property <[SongItem]> songs: [];          // songs of the selected playlist

    // ---------- History ----------
    in property <[ScrobbleItem]> history: [];
    in property <[StatItem]> top-artists: [];
    in property <[StatItem]> top-albums: [];
    in property <[StatItem]> top-tracks: [];
    in property <[StatItem]> daily-plays: [];
    in property <int> total-plays: 0;
    in property <int> plays-today: 0;
    in property <int> unique-artists: 0;

    // ---------- Player ----------
    in property <string> current-title: "Nada tocando";
    in property <string> current-artist: "Selecione uma música na biblioteca";
    in property <string> current-album: "";
    in property <image> cover-art;
    in property <bool> playing: false;
    in property <bool> shuffle-on: false;
    in property <int> repeat-mode: 0;            // 0 off, 1 all, 2 one
    in-out property <float> progress: 0.0;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in-out property <float> volume: 0.7;
    in property <[QueueItem]> queue: [];
    in property <string> queue-info: "";

    // ---------- Settings ----------
    in-out property <float> eq-bass: 0;          // -12 .. +12 dB
    in-out property <float> eq-mid: 0;
    in-out property <float> eq-treble: 0;
    in-out property <int> eq-preset: 0;
    in-out property <int> crossfade: 0;          // 0 .. 12 s
    in-out property <int> normalization: 0;      // 0 off, 1 quiet, 2 normal, 3 loud
    in-out property <bool> mono: false;
    in-out property <int> sleep-minutes: 0;      // 0 off
    in property <string> sleep-remaining: "";

    // ---------- Callbacks ----------
    callback play-pause;
    callback next-track;
    callback prev-track;
    callback seek(float);
    callback toggle-shuffle;
    callback cycle-repeat;
    callback volume-changed(float);

    callback queue-play(int);
    callback queue-remove(int);
    callback queue-move(int, int);

    callback search-changed(string);
    callback play-search-result(int);

    callback set-sort-mode(int);
    callback play-library-song(int);
    callback play-album(int);
    callback play-artist(int);

    callback create-playlist(string);
    callback delete-playlist(int);
    callback rename-playlist(int, string);
    callback set-playlist-cover(int);
    callback add-songs(int);
    callback remove-song(int, int);
    callback move-song(int, int, int);
    callback select-playlist(int);
    callback play-playlist-from(int, int);

    callback play-recent-song(string);
    callback play-recent-playlist(int);
    callback refresh-home;
    callback refresh-history;

    callback eq-changed(float, float, float);
    callback set-eq-preset(int);
    callback set-crossfade(int);
    callback set-normalization(int);
    callback set-mono(bool);
    callback set-sleep(int);

    // Local UI state
    property <bool> renaming: false;
    property <bool> creating: false;
    property <bool> wide: root.width > 1020px;
    property <length> side-w: root.wide ? 208px : 68px;

    // ==================== Sidebar ====================
    Rectangle {
                x: 0;
                y: 0;
                width: root.side-w;
                height: root.height - 96px;
                background: Theme.surface;
                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    // Logo
                    Rectangle {
                        height: 54px;
                        HorizontalLayout {
                            alignment: root.wide ? start : center;
                            padding-left: root.wide ? 8px : 0px;
                            spacing: 10px;
                            Rectangle {
                                width: 34px;
                                height: 34px;
                                y: 10px;
                                border-radius: 10px;
                                clip: true;
                                Image {
                                    width: 100%;
                                    height: 100%;
                                    source: @image-url("../Logo.jpg");
                                    image-fit: ImageFit.cover;
                                }
                            }
                            if root.wide: Text {
                                text: "Ohm Player";
                                color: Theme.text;
                                font-size: 16px;
                                font-weight: 800;
                                vertical-alignment: center;
                            }
                        }
                    }
                    NavItem {
                        icon: "🏠";
                        label: "Início";
                        expanded: root.wide;
                        active: root.active-page == 0;
                        clicked => { root.active-page = 0; root.refresh-home(); }
                    }
                    NavItem {
                        icon: "🔍";
                        label: "Buscar";
                        expanded: root.wide;
                        active: root.active-page == 1;
                        clicked => { root.active-page = 1; }
                    }
                    NavItem {
                        icon: "📚";
                        label: "Sua Biblioteca";
                        expanded: root.wide;
                        active: root.active-page == 2;
                        clicked => { root.active-page = 2; }
                    }
                    NavItem {
                        icon: "🕐";
                        label: "Histórico";
                        expanded: root.wide;
                        active: root.active-page == 4;
                        clicked => { root.active-page = 4; root.refresh-history(); }
                    }
                    Rectangle { }
                    NavItem {
                        icon: "⚙";
                        label: "Áudio";
                        expanded: root.wide;
                        active: root.active-page == 3;
                        clicked => { root.active-page = 3; }
                    }
                }
            }

            // ==================== Top bar + page area ====================
            Rectangle {
                x: root.side-w;
                y: 0;
                width: root.width - root.side-w;
                height: root.height - 96px;
                VerticalLayout {
                width: parent.width;
                height: parent.height;
                Rectangle {
                    height: 62px;
                    background: Theme.bg;
                    HorizontalLayout {
                        padding-left: 22px;
                        padding-right: 22px;
                        spacing: 14px;
                        alignment: space-between;
                        // Search field
                        Rectangle {
                            y: 12px;
                            height: 38px;
                            width: min(460px, parent.width - 120px);
                            border-radius: 19px;
                            background: Theme.surface2;
                            border-width: 1px;
                            border-color: search-input.has-focus ? Theme.accent : Theme.stroke;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 8px;
                                Text {
                                    text: "🔍";
                                    font-size: 13px;
                                    color: Theme.muted;
                                    vertical-alignment: center;
                                }
                                search-input := LineEdit {
                                    placeholder-text: "Buscar faixas, artistas ou álbuns no dispositivo…";
                                    font-size: 13px;
                                    edited => {
                                        root.active-page = 1;
                                        root.search-changed(self.text);
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            IconButton {
                                y: 13px;
                                icon: "🕐";
                                tip: "Histórico de execução";
                                active: root.active-page == 4;
                                clicked => { root.active-page = 4; root.refresh-history(); }
                            }
                            IconButton {
                                y: 13px;
                                icon: "⚙";
                                tip: "Painel de áudio";
                                active: root.active-page == 3;
                                clicked => { root.active-page = 3; }
                            }
                        }
                    }
                }

                // ==================== Pages ====================
                page-area := Rectangle {
                    background: Theme.bg;

                    // ---------- Page 0: Home ----------
                    if root.active-page == 0: Flickable {
                        width: 100%;
                        height: 100%;
                        viewport-height: home-col.preferred-height + 40px;
                        home-col := VerticalLayout {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            padding: 24px;
                            spacing: 20px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "Início";
                                    color: Theme.text;
                                    font-size: 26px;
                                    font-weight: 800;
                                }
                                IconButton {
                                    icon: "🕐";
                                    size: 40px;
                                    icon-size: 17px;
                                    clicked => { root.active-page = 4; root.refresh-history(); }
                                }
                            }

                            SectionTitle { text: "Tocadas recentes"; }
                            if root.recent-playlists.length == 0: Text {
                                text: "Toque uma playlist para ela aparecer aqui.";
                                color: Theme.muted;
                                font-size: 13px;
                            }
                            // Responsive grid of recent playlists
                            recent-grid := Rectangle {
                                property <int> cols: max(2, floor(self.width / 168px));
                                property <length> cw: self.width / self.cols;
                                property <length> ch: 200px;
                                height: root.recent-playlists.length == 0 ? 0px
                                    : ceil(root.recent-playlists.length * 1.0 / self.cols) * self.ch;
                                for p[i] in root.recent-playlists: Rectangle {
                                    x: mod(i, recent-grid.cols) * recent-grid.cw;
                                    y: floor(i / recent-grid.cols) * recent-grid.ch;
                                    width: recent-grid.cw;
                                    height: recent-grid.ch;
                                    Rectangle {
                                        x: 6px;
                                        y: 6px;
                                        width: parent.width - 12px;
                                        height: parent.height - 12px;
                                        border-radius: 12px;
                                        background: rp-ta.has-hover ? Theme.surface2 : Theme.surface;
                                        animate background { duration: 120ms; }
                                        rp-ta := TouchArea {
                                            clicked => { root.play-recent-playlist(p.id); }
                                        }
                                        VerticalLayout {
                                            padding: 12px;
                                            spacing: 8px;
                                            CoverBox {
                                                height: parent.width - 24px;
                                                border-radius: 8px;
                                                cover: p.cover;
                                                glyph: "🎵";
                                            }
                                            Text {
                                                text: p.name;
                                                color: Theme.text;
                                                font-size: 13px;
                                                font-weight: 700;
                                                overflow: elide;
                                            }
                                        }
                                        if rp-ta.has-hover: Rectangle {
                                            width: 40px;
                                            height: 40px;
                                            border-radius: 20px;
                                            background: Theme.accent;
                                            x: parent.width - 52px;
                                            y: parent.height - 82px;
                                            drop-shadow-blur: 12px;
                                            drop-shadow-color: #00000080;
                                            Text {
                                                width: 100%;
                                                height: 100%;
                                                text: "▶";
                                                color: #ffffff;
                                                font-size: 14px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            SectionTitle { text: "Ouvidas recentemente"; }
                            if root.recent-songs.length == 0: Text {
                                text: "As últimas músicas reproduzidas aparecerão aqui.";
                                color: Theme.muted;
                                font-size: 13px;
                            }
                            VerticalLayout {
                                spacing: 2px;
                                for s[i] in root.recent-songs: SongRow {
                                    index: i;
                                    title: s.title;
                                    subtitle: s.artist;
                                    trailing: s.album;
                                    play => { root.play-recent-song(s.path); }
                                }
                            }
                        }
                    }

                    // ---------- Page 1: Search ----------
                    if root.active-page == 1: VerticalLayout {
                        padding: 24px;
                        spacing: 16px;
                        Text {
                            text: "Localizar no dispositivo";
                            color: Theme.text;
                            font-size: 26px;
                            font-weight: 800;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Chip {
                                label: "Tudo";
                                active: root.search-filter == 0;
                                clicked => { root.search-filter = 0; root.search-changed(search-input.text); }
                            }
                            Chip {
                                label: "🎵 Músicas";
                                active: root.search-filter == 1;
                                clicked => { root.search-filter = 1; root.search-changed(search-input.text); }
                            }
                            Chip {
                                label: "🎙 Voz e podcasts";
                                active: root.search-filter == 2;
                                clicked => { root.search-filter = 2; root.search-changed(search-input.text); }
                            }
                        }
                        if root.search-results.length == 0: VerticalLayout {
                            alignment: center;
                            spacing: 8px;
                            Text {
                                text: "🔍";
                                font-size: 40px;
                                color: Theme.surface3;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: search-input.text == "" ? "Digite para varrer o armazenamento interno."
                                    : "Nenhum arquivo local corresponde à busca.";
                                color: Theme.muted;
                                font-size: 14px;
                                horizontal-alignment: center;
                            }
                        }
                        if root.search-results.length > 0: ListView {
                            for s[i] in root.search-results: SongRow {
                                index: i;
                                title: s.title;
                                subtitle: s.artist;
                                trailing: s.album;
                                voice-badge: s.is-voice;
                                play => { root.play-search-result(i); }
                            }
                        }
                    }

                    // ---------- Page 2: Library ----------
                    if root.active-page == 2 && root.selected-playlist-id == -1: VerticalLayout {
                        padding: 24px;
                        spacing: 16px;
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "Sua Biblioteca";
                                color: Theme.text;
                                font-size: 26px;
                                font-weight: 800;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                // Sort cycle button
                                Rectangle {
                                    height: 34px;
                                    width: sort-label.preferred-width + 34px;
                                    border-radius: 17px;
                                    background: sort-ta.has-hover ? Theme.surface3 : Theme.surface2;
                                    border-width: 1px;
                                    border-color: Theme.stroke;
                                    sort-label := Text {
                                        width: 100%;
                                        height: 100%;
                                        text: root.sort-mode == 0 ? "⇅  A–Z"
                                            : root.sort-mode == 1 ? "⇅  Adicionados recentemente"
                                            : "⇅  Tocados recentemente";
                                        color: Theme.text;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    sort-ta := TouchArea {
                                        clicked => {
                                            root.sort-mode = mod(root.sort-mode + 1, 3);
                                            root.set-sort-mode(root.sort-mode);
                                        }
                                    }
                                }
                                if root.library-tab == 0: Rectangle {
                                    height: 34px;
                                    width: np-label.preferred-width + 34px;
                                    border-radius: 17px;
                                    background: Theme.accent;
                                    np-label := Text {
                                        width: 100%;
                                        height: 100%;
                                        text: "+ Nova playlist";
                                        color: #ffffff;
                                        font-size: 12px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea {
                                        clicked => { root.creating = true; }
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Chip {
                                label: "Playlists";
                                active: root.library-tab == 0;
                                clicked => { root.library-tab = 0; }
                            }
                            Chip {
                                label: "Músicas";
                                active: root.library-tab == 1;
                                clicked => { root.library-tab = 1; }
                            }
                            Chip {
                                label: "Álbuns";
                                active: root.library-tab == 2;
                                clicked => { root.library-tab = 2; }
                            }
                            Chip {
                                label: "Artistas";
                                active: root.library-tab == 3;
                                clicked => { root.library-tab = 3; }
                            }
                        }

                        // Inline create-playlist editor
                        if root.creating && root.library-tab == 0: Rectangle {
                            height: 48px;
                            border-radius: 10px;
                            background: Theme.surface2;
                            HorizontalLayout {
                                padding: 8px;
                                spacing: 8px;
                                new-pl-name := LineEdit {
                                    placeholder-text: "Nome da nova playlist…";
                                    font-size: 13px;
                                    accepted => {
                                        if (self.text != "") {
                                            root.create-playlist(self.text);
                                            self.text = "";
                                            root.creating = false;
                                        }
                                    }
                                }
                                Rectangle {
                                    width: 80px;
                                    border-radius: 8px;
                                    background: Theme.accent;
                                    Text {
                                        width: 100%;
                                        height: 100%;
                                        text: "Criar";
                                        color: #ffffff;
                                        font-size: 12px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea {
                                        clicked => {
                                            if (new-pl-name.text != "") {
                                                root.create-playlist(new-pl-name.text);
                                                new-pl-name.text = "";
                                                root.creating = false;
                                            }
                                        }
                                    }
                                }
                                Rectangle {
                                    width: 90px;
                                    border-radius: 8px;
                                    background: Theme.surface3;
                                    Text {
                                        width: 100%;
                                        height: 100%;
                                        text: "Cancelar";
                                        color: Theme.muted;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea {
                                        clicked => { root.creating = false; }
                                    }
                                }
                            }
                        }

                        // --- Tab 0: playlists grid ---
                        if root.library-tab == 0: Flickable {
                            viewport-height: pl-grid.height + 20px;
                            pl-grid := Rectangle {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                property <int> cols: max(2, floor(self.width / 186px));
                                property <length> cw: self.width / self.cols;
                                property <length> ch: 226px;
                                height: root.playlists.length == 0 ? 120px
                                    : ceil(root.playlists.length * 1.0 / self.cols) * self.ch;
                                if root.playlists.length == 0: Text {
                                    text: "Nenhuma playlist ainda. Crie a primeira!";
                                    color: Theme.muted;
                                    font-size: 14px;
                                    x: 8px;
                                    y: 8px;
                                }
                                for p[i] in root.playlists: Rectangle {
                                    x: mod(i, pl-grid.cols) * pl-grid.cw;
                                    y: floor(i / pl-grid.cols) * pl-grid.ch;
                                    width: pl-grid.cw;
                                    height: pl-grid.ch;
                                    Rectangle {
                                        x: 7px;
                                        y: 7px;
                                        width: parent.width - 14px;
                                        height: parent.height - 14px;
                                        border-radius: 12px;
                                        background: pl-ta.has-hover ? Theme.surface2 : Theme.surface;
                                        animate background { duration: 120ms; }
                                        pl-ta := TouchArea {
                                            clicked => { root.select-playlist(p.id); }
                                        }
                                        VerticalLayout {
                                            padding: 12px;
                                            spacing: 6px;
                                            CoverBox {
                                                height: parent.width - 24px;
                                                border-radius: 8px;
                                                cover: p.cover;
                                                glyph: "🎵";
                                            }
                                            Text {
                                                text: p.name;
                                                color: Theme.text;
                                                font-size: 13px;
                                                font-weight: 700;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: p.song-count == 1 ? "1 faixa" : p.song-count + " faixas";
                                                color: Theme.muted;
                                                font-size: 11px;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // --- Tab 1: all songs ---
                        if root.library-tab == 1: ListView {
                            for s[i] in root.library-songs: SongRow {
                                index: i;
                                title: s.title;
                                subtitle: s.artist;
                                trailing: s.album;
                                voice-badge: s.is-voice;
                                play => { root.play-library-song(i); }
                            }
                        }

                        // --- Tab 2: albums grid ---
                        if root.library-tab == 2: Flickable {
                            viewport-height: al-grid.height + 20px;
                            al-grid := Rectangle {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                property <int> cols: max(2, floor(self.width / 186px));
                                property <length> cw: self.width / self.cols;
                                property <length> ch: 238px;
                                height: root.albums.length == 0 ? 120px
                                    : ceil(root.albums.length * 1.0 / self.cols) * self.ch;
                                if root.albums.length == 0: Text {
                                    text: "Adicione músicas às playlists para indexar os álbuns.";
                                    color: Theme.muted;
                                    font-size: 14px;
                                    x: 8px;
                                    y: 8px;
                                }
                                for a[i] in root.albums: Rectangle {
                                    x: mod(i, al-grid.cols) * al-grid.cw;
                                    y: floor(i / al-grid.cols) * al-grid.ch;
                                    width: al-grid.cw;
                                    height: al-grid.ch;
                                    Rectangle {
                                        x: 7px;
                                        y: 7px;
                                        width: parent.width - 14px;
                                        height: parent.height - 14px;
                                        border-radius: 12px;
                                        background: al-ta.has-hover ? Theme.surface2 : Theme.surface;
                                        animate background { duration: 120ms; }
                                        al-ta := TouchArea {
                                            clicked => { root.play-album(i); }
                                        }
                                        VerticalLayout {
                                            padding: 12px;
                                            spacing: 6px;
                                            CoverBox {
                                                height: parent.width - 24px;
                                                border-radius: 8px;
                                                cover: a.cover;
                                                glyph: "💿";
                                            }
                                            Text {
                                                text: a.name;
                                                color: Theme.text;
                                                font-size: 13px;
                                                font-weight: 700;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: a.artist + " · " + a.count + " faixas";
                                                color: Theme.muted;
                                                font-size: 11px;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // --- Tab 3: artists ---
                        if root.library-tab == 3: ListView {
                            for a[i] in root.artists: Rectangle {
                                height: 58px;
                                border-radius: 8px;
                                background: ar-ta.has-hover ? Theme.surface2 : transparent;
                                ar-ta := TouchArea {
                                    clicked => { root.play-artist(i); }
                                }
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 12px;
                                    Rectangle {
                                        width: 42px;
                                        height: 42px;
                                        y: 8px;
                                        border-radius: 21px;
                                        background: @linear-gradient(135deg, #8b5cf6 0%, #22d3ee 100%);
                                        Text {
                                            width: 100%;
                                            height: 100%;
                                            text: "👤";
                                            font-size: 16px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: a.name;
                                            color: Theme.text;
                                            font-size: 13px;
                                            font-weight: 600;
                                        }
                                        Text {
                                            text: a.count == 1 ? "1 faixa" : a.count + " faixas";
                                            color: Theme.muted;
                                            font-size: 11px;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ---------- Page 2b: playlist detail ----------
                    if root.active-page == 2 && root.selected-playlist-id != -1: VerticalLayout {
                        padding: 24px;
                        spacing: 16px;
                        HorizontalLayout {
                            spacing: 16px;
                            IconButton {
                                icon: "⬅️";
                                size: 38px;
                                icon-size: 17px;
                                clicked => {
                                    root.select-playlist(-1);
                                    root.renaming = false;
                                }
                            }
                            CoverBox {
                                width: 120px;
                                height: 120px;
                                border-radius: 10px;
                                cover: root.selected-playlist-cover;
                                glyph: "🎵";
                                TouchArea {
                                    clicked => { root.set-playlist-cover(root.selected-playlist-id); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 8px;
                                Text {
                                    text: "PLAYLIST";
                                    color: Theme.muted;
                                    font-size: 11px;
                                    letter-spacing: 1.5px;
                                }
                                if !root.renaming: Text {
                                    text: root.selected-playlist-name;
                                    color: Theme.text;
                                    font-size: 28px;
                                    font-weight: 800;
                                    overflow: elide;
                                }
                                if root.renaming: HorizontalLayout {
                                    spacing: 8px;
                                    rename-edit := LineEdit {
                                        text: root.selected-playlist-name;
                                        font-size: 16px;
                                        width: 280px;
                                        accepted => {
                                            root.rename-playlist(root.selected-playlist-id, self.text);
                                            root.renaming = false;
                                        }
                                    }
                                    Rectangle {
                                        width: 60px;
                                        height: 34px;
                                        border-radius: 8px;
                                        background: Theme.accent;
                                        Text {
                                            width: 100%;
                                            height: 100%;
                                            text: "OK";
                                            color: #ffffff;
                                            font-size: 12px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        TouchArea {
                                            clicked => {
                                                root.rename-playlist(root.selected-playlist-id, rename-edit.text);
                                                root.renaming = false;
                                            }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Rectangle {
                                        width: 110px;
                                        height: 36px;
                                        border-radius: 18px;
                                        background: Theme.accent;
                                        Text {
                                            width: 100%;
                                            height: 100%;
                                            text: "▶  Tocar";
                                            color: #ffffff;
                                            font-size: 13px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        TouchArea {
                                            clicked => { root.play-playlist-from(root.selected-playlist-id, 0); }
                                        }
                                    }
                                    Rectangle {
                                        width: 130px;
                                        height: 36px;
                                        border-radius: 18px;
                                        background: Theme.surface2;
                                        border-width: 1px;
                                        border-color: Theme.stroke;
                                        Text {
                                            width: 100%;
                                            height: 100%;
                                            text: "+ Adicionar faixas";
                                            color: Theme.text;
                                            font-size: 12px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        TouchArea {
                                            clicked => { root.add-songs(root.selected-playlist-id); }
                                        }
                                    }
                                    IconButton {
                                        icon: "✏️";
                                        tip: "Renomear";
                                        clicked => { root.renaming = !root.renaming; }
                                    }
                                    IconButton {
                                        icon: "🖼";
                                        tip: "Mudar capa";
                                        clicked => { root.set-playlist-cover(root.selected-playlist-id); }
                                    }
                                    IconButton {
                                        icon: "🗑️";
                                        tip: "Excluir playlist";
                                        clicked => { root.delete-playlist(root.selected-playlist-id); }
                                    }
                                }
                            }
                        }
                        if root.songs.length == 0: Text {
                            text: "Playlist vazia — adicione faixas do seu armazenamento.";
                            color: Theme.muted;
                            font-size: 13px;
                        }
                        ListView {
                            for s[i] in root.songs: Rectangle {
                                height: 52px;
                                border-radius: 8px;
                                background: dt-ta.has-hover ? Theme.surface2 : transparent;
                                dt-ta := TouchArea {
                                    clicked => { root.play-playlist-from(root.selected-playlist-id, i); }
                                }
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 8px;
                                    spacing: 12px;
                                    Rectangle {
                                        width: 26px;
                                        Text {
                                            width: 100%;
                                            height: 100%;
                                            text: dt-ta.has-hover ? "▶" : i + 1;
                                            color: dt-ta.has-hover ? Theme.accent : Theme.muted;
                                            font-size: 12px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: s.title;
                                            color: Theme.text;
                                            font-size: 13px;
                                            font-weight: 600;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: s.artist;
                                            color: Theme.muted;
                                            font-size: 11px;
                                            overflow: elide;
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 2px;
                                        alignment: end;
                                        IconButton {
                                            icon: "🔼";
                                            size: 30px;
                                            icon-size: 10px;
                                            clicked => {
                                                if (i > 0) { root.move-song(root.selected-playlist-id, i, i - 1); }
                                            }
                                        }
                                        IconButton {
                                            icon: "🔽";
                                            size: 30px;
                                            icon-size: 10px;
                                            clicked => {
                                                if (i < root.songs.length - 1) { root.move-song(root.selected-playlist-id, i, i + 1); }
                                            }
                                        }
                                        IconButton {
                                            icon: "❌";
                                            size: 30px;
                                            icon-size: 10px;
                                            clicked => { root.remove-song(root.selected-playlist-id, i); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ---------- Page 3: Audio engineering panel ----------
                    if root.active-page == 3: Flickable {
                        viewport-height: set-col.preferred-height + 40px;
                        set-col := VerticalLayout {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            padding: 24px;
                            spacing: 18px;
                            Text {
                                text: "Painel de Engenharia de Áudio";
                                color: Theme.text;
                                font-size: 26px;
                                font-weight: 800;
                            }

                            // ----- Equalizer card -----
                            Rectangle {
                                border-radius: 14px;
                                background: Theme.surface;
                                height: eq-col.preferred-height + 40px;
                                eq-col := VerticalLayout {
                                    padding: 20px;
                                    spacing: 14px;
                                    SectionTitle { text: "🎛  Equalizador Ativo"; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        Chip {
                                            label: "Neutro";
                                            active: root.eq-preset == 0;
                                            clicked => { root.set-eq-preset(0); }
                                        }
                                        Chip {
                                            label: "Rock";
                                            active: root.eq-preset == 1;
                                            clicked => { root.set-eq-preset(1); }
                                        }
                                        Chip {
                                            label: "Clássica";
                                            active: root.eq-preset == 2;
                                            clicked => { root.set-eq-preset(2); }
                                        }
                                        Chip {
                                            label: "Reforço de Graves";
                                            active: root.eq-preset == 3;
                                            clicked => { root.set-eq-preset(3); }
                                        }
                                        Chip {
                                            label: "Pop";
                                            active: root.eq-preset == 4;
                                            clicked => { root.set-eq-preset(4); }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 30px;
                                        alignment: start;
                                        padding-left: 10px;
                                        VerticalLayout {
                                            spacing: 6px;
                                            width: 90px;
                                            Text {
                                                text: round(root.eq-bass) + " dB";
                                                color: Theme.accent2;
                                                font-size: 11px;
                                                horizontal-alignment: center;
                                            }
                                            VSlider {
                                                height: 130px;
                                                value: (root.eq-bass + 12) / 24;
                                                changed(v) => {
                                                    root.eq-bass = v * 24 - 12;
                                                    root.eq-preset = -1;
                                                    root.eq-changed(root.eq-bass, root.eq-mid, root.eq-treble);
                                                }
                                            }
                                            Text {
                                                text: "Graves";
                                                color: Theme.muted;
                                                font-size: 12px;
                                                horizontal-alignment: center;
                                            }
                                        }
                                        VerticalLayout {
                                            spacing: 6px;
                                            width: 90px;
                                            Text {
                                                text: round(root.eq-mid) + " dB";
                                                color: Theme.accent2;
                                                font-size: 11px;
                                                horizontal-alignment: center;
                                            }
                                            VSlider {
                                                height: 130px;
                                                value: (root.eq-mid + 12) / 24;
                                                changed(v) => {
                                                    root.eq-mid = v * 24 - 12;
                                                    root.eq-preset = -1;
                                                    root.eq-changed(root.eq-bass, root.eq-mid, root.eq-treble);
                                                }
                                            }
                                            Text {
                                                text: "Médios";
                                                color: Theme.muted;
                                                font-size: 12px;
                                                horizontal-alignment: center;
                                            }
                                        }
                                        VerticalLayout {
                                            spacing: 6px;
                                            width: 90px;
                                            Text {
                                                text: round(root.eq-treble) + " dB";
                                                color: Theme.accent2;
                                                font-size: 11px;
                                                horizontal-alignment: center;
                                            }
                                            VSlider {
                                                height: 130px;
                                                value: (root.eq-treble + 12) / 24;
                                                changed(v) => {
                                                    root.eq-treble = v * 24 - 12;
                                                    root.eq-preset = -1;
                                                    root.eq-changed(root.eq-bass, root.eq-mid, root.eq-treble);
                                                }
                                            }
                                            Text {
                                                text: "Agudos";
                                                color: Theme.muted;
                                                font-size: 12px;
                                                horizontal-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            // ----- Crossfade card -----
                            Rectangle {
                                border-radius: 14px;
                                background: Theme.surface;
                                height: cf-col.preferred-height + 40px;
                                cf-col := VerticalLayout {
                                    padding: 20px;
                                    spacing: 12px;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        SectionTitle { text: "🔀  Crossfade (Transição Suave)"; }
                                        Text {
                                            text: root.crossfade == 0 ? "Desligado" : root.crossfade + " s";
                                            color: Theme.accent2;
                                            font-size: 13px;
                                            font-weight: 700;
                                        }
                                    }
                                    Text {
                                        text: "O volume da faixa atual diminui enquanto a próxima começa, eliminando o silêncio entre elas.";
                                        color: Theme.muted;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                    HSlider {
                                        value: root.crossfade / 12.0;
                                        changed(v) => {
                                            root.crossfade = round(v * 12);
                                            root.set-crossfade(root.crossfade);
                                        }
                                    }
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "0 s"; color: Theme.muted; font-size: 10px; }
                                        Text { text: "12 s"; color: Theme.muted; font-size: 10px; }
                                    }
                                }
                            }

                            // ----- Normalizer card -----
                            Rectangle {
                                border-radius: 14px;
                                background: Theme.surface;
                                height: nm-col.preferred-height + 40px;
                                nm-col := VerticalLayout {
                                    padding: 20px;
                                    spacing: 12px;
                                    SectionTitle { text: "📶  Normalizador de Volume"; }
                                    Text {
                                        text: "Padroniza o ganho entre os arquivos para evitar que uma música toque muito mais alto que a outra.";
                                        color: Theme.muted;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        Chip {
                                            label: "Desligado";
                                            active: root.normalization == 0;
                                            clicked => { root.set-normalization(0); }
                                        }
                                        Chip {
                                            label: "Silencioso";
                                            active: root.normalization == 1;
                                            clicked => { root.set-normalization(1); }
                                        }
                                        Chip {
                                            label: "Normal";
                                            active: root.normalization == 2;
                                            clicked => { root.set-normalization(2); }
                                        }
                                        Chip {
                                            label: "Barulhento";
                                            active: root.normalization == 3;
                                            clicked => { root.set-normalization(3); }
                                        }
                                    }
                                }
                            }

                            // ----- Mono card -----
                            Rectangle {
                                border-radius: 14px;
                                background: Theme.surface;
                                height: 84px;
                                HorizontalLayout {
                                    padding: 20px;
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 4px;
                                        alignment: center;
                                        SectionTitle { text: "🎧  Áudio Mono"; }
                                        Text {
                                            text: "Funde os canais esquerdo e direito em um canal único.";
                                            color: Theme.muted;
                                            font-size: 12px;
                                        }
                                    }
                                    Toggle {
                                        y: (parent.height - self.height) / 2;
                                        checked: root.mono;
                                        toggled(v) => { root.set-mono(v); }
                                    }
                                }
                            }

                            // ----- Sleep timer card -----
                            Rectangle {
                                border-radius: 14px;
                                background: Theme.surface;
                                height: sl-col.preferred-height + 40px;
                                sl-col := VerticalLayout {
                                    padding: 20px;
                                    spacing: 12px;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        SectionTitle { text: "🌙  Temporizador (Sleep Timer)"; }
                                        Text {
                                            text: root.sleep-remaining;
                                            color: Theme.accent2;
                                            font-size: 13px;
                                            font-weight: 700;
                                        }
                                    }
                                    Text {
                                        text: "Interrompe a reprodução e desliga o motor de áudio após o tempo programado.";
                                        color: Theme.muted;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        Chip {
                                            label: "Desligado";
                                            active: root.sleep-minutes == 0;
                                            clicked => { root.set-sleep(0); }
                                        }
                                        Chip {
                                            label: "5 min";
                                            active: root.sleep-minutes == 5;
                                            clicked => { root.set-sleep(5); }
                                        }
                                        Chip {
                                            label: "10 min";
                                            active: root.sleep-minutes == 10;
                                            clicked => { root.set-sleep(10); }
                                        }
                                        Chip {
                                            label: "30 min";
                                            active: root.sleep-minutes == 30;
                                            clicked => { root.set-sleep(30); }
                                        }
                                        Chip {
                                            label: "45 min";
                                            active: root.sleep-minutes == 45;
                                            clicked => { root.set-sleep(45); }
                                        }
                                        Chip {
                                            label: "60 min";
                                            active: root.sleep-minutes == 60;
                                            clicked => { root.set-sleep(60); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ---------- Page 4: History & statistics ----------
                    if root.active-page == 4: Flickable {
                        viewport-height: hist-col.preferred-height + 40px;
                        hist-col := VerticalLayout {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            padding: 24px;
                            spacing: 18px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "🕐  Histórico e Estatísticas";
                                    color: Theme.text;
                                    font-size: 26px;
                                    font-weight: 800;
                                }
                                Rectangle {
                                    width: 116px;
                                    height: 34px;
                                    border-radius: 17px;
                                    background: Theme.surface2;
                                    border-width: 1px;
                                    border-color: Theme.stroke;
                                    Text {
                                        width: 100%;
                                        height: 100%;
                                        text: "🔄 Atualizar";
                                        color: Theme.text;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea {
                                        clicked => { root.refresh-history(); }
                                    }
                                }
                            }

                            // ----- Stat cards -----
                            HorizontalLayout {
                                spacing: 14px;
                                StatCard {
                                    icon: "🎧";
                                    value: root.total-plays;
                                    label: "Reproduções no total";
                                }
                                StatCard {
                                    icon: "📅";
                                    value: root.plays-today;
                                    label: "Reproduções hoje";
                                }
                                StatCard {
                                    icon: "🎤";
                                    value: root.unique-artists;
                                    label: "Artistas diferentes";
                                }
                            }

                            // ----- Daily plays bar chart -----
                            Rectangle {
                                height: 210px;
                                border-radius: 14px;
                                background: Theme.surface;
                                border-width: 1px;
                                border-color: Theme.stroke;
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 10px;
                                    SectionTitle { text: "📊  Últimos 7 dias"; }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        for d[i] in root.daily-plays: VerticalLayout {
                                            spacing: 4px;
                                            Rectangle {
                                                // Bar track
                                                Rectangle {
                                                    x: parent.width / 2 - 14px;
                                                    y: parent.height - max(parent.height * d.ratio, 4px);
                                                    width: 28px;
                                                    height: max(parent.height * d.ratio, 4px);
                                                    border-radius: 4px;
                                                    background: @linear-gradient(180deg, #8b5cf6 0%, #22d3ee 100%);
                                                }
                                            }
                                            Text {
                                                text: d.count;
                                                color: Theme.text;
                                                font-size: 11px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                            }
                                            Text {
                                                text: d.name;
                                                color: Theme.muted;
                                                font-size: 10px;
                                                horizontal-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            // ----- Top charts (artists / albums / tracks) -----
                            HorizontalLayout {
                                spacing: 14px;
                                Rectangle {
                                    border-radius: 14px;
                                    background: Theme.surface;
                                    border-width: 1px;
                                    border-color: Theme.stroke;
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 8px;
                                        SectionTitle { text: "🎤  Top Artistas"; }
                                        if root.top-artists.length == 0: Text {
                                            text: "Sem dados ainda.";
                                            color: Theme.muted;
                                            font-size: 12px;
                                        }
                                        for a[i] in root.top-artists: TopRow {
                                            rank: i + 1;
                                            name: a.name;
                                            count: a.count;
                                            ratio: a.ratio;
                                            bar-color: Theme.accent;
                                        }
                                    }
                                }
                                Rectangle {
                                    border-radius: 14px;
                                    background: Theme.surface;
                                    border-width: 1px;
                                    border-color: Theme.stroke;
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 8px;
                                        SectionTitle { text: "💿  Top Álbuns"; }
                                        if root.top-albums.length == 0: Text {
                                            text: "Sem dados ainda.";
                                            color: Theme.muted;
                                            font-size: 12px;
                                        }
                                        for a[i] in root.top-albums: TopRow {
                                            rank: i + 1;
                                            name: a.name;
                                            count: a.count;
                                            ratio: a.ratio;
                                            bar-color: Theme.accent2;
                                        }
                                    }
                                }
                                Rectangle {
                                    border-radius: 14px;
                                    background: Theme.surface;
                                    border-width: 1px;
                                    border-color: Theme.stroke;
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 8px;
                                        SectionTitle { text: "🎵  Top Faixas"; }
                                        if root.top-tracks.length == 0: Text {
                                            text: "Sem dados ainda.";
                                            color: Theme.muted;
                                            font-size: 12px;
                                        }
                                        for a[i] in root.top-tracks: TopRow {
                                            rank: i + 1;
                                            name: a.name;
                                            count: a.count;
                                            ratio: a.ratio;
                                            bar-color: #f59e0b;
                                        }
                                    }
                                }
                            }

                            // ----- Timeline -----
                            SectionTitle { text: "🕐  Linha do tempo"; }
                            if root.history.length == 0: Text {
                                text: "Nenhuma reprodução registrada ainda.";
                                color: Theme.muted;
                                font-size: 13px;
                            }
                            for h[i] in root.history: Rectangle {
                                height: 56px;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    spacing: 14px;
                                    // Timeline rail
                                    Rectangle {
                                        width: 20px;
                                        Rectangle {
                                            x: 9px;
                                            y: 0;
                                            width: 2px;
                                            height: parent.height;
                                            background: Theme.surface3;
                                        }
                                        Rectangle {
                                            x: 4px;
                                            y: parent.height / 2 - 6px;
                                            width: 12px;
                                            height: 12px;
                                            border-radius: 6px;
                                            background: i == 0 ? Theme.accent : Theme.surface3;
                                            border-width: 2px;
                                            border-color: Theme.bg;
                                        }
                                    }
                                    Text {
                                        text: h.time;
                                        color: Theme.accent2;
                                        font-size: 12px;
                                        width: 46px;
                                        vertical-alignment: center;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: h.title;
                                            color: Theme.text;
                                            font-size: 13px;
                                            font-weight: 600;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: h.album == "" ? h.artist : h.artist + "  •  " + h.album;
                                            color: Theme.muted;
                                            font-size: 11px;
                                            overflow: elide;
                                        }
                                    }
                                    Text {
                                        text: h.date;
                                        color: Theme.muted;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                        width: 90px;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }




        // ==================== Player bar (always visible) ====================
        Rectangle {
            x: 0;
            y: root.height - 96px;
            width: root.width;
            height: 96px;
            background: Theme.surface;
            Rectangle {
                x: 0;
                y: 0;
                width: 100%;
                height: 1px;
                background: Theme.stroke;
            }
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 14px;
                // ----- Left: now playing metadata -----
                HorizontalLayout {
                    spacing: 12px;
                    width: root.wide ? 26% : 30%;
                    CoverBox {
                        width: 64px;
                        height: 64px;
                        y: 16px;
                        border-radius: 8px;
                        cover: root.cover-art;
                        glyph: "♪";
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        Text {
                            text: root.current-title;
                            color: Theme.text;
                            font-size: 13px;
                            font-weight: 700;
                            overflow: elide;
                        }
                        Text {
                            text: root.current-artist;
                            color: Theme.muted;
                            font-size: 11px;
                            overflow: elide;
                        }
                        Text {
                            text: root.queue-info;
                            color: Theme.surface3;
                            font-size: 10px;
                            overflow: elide;
                        }
                    }
                }
                // ----- Center: transport + progress -----
                VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 10px;
                        IconButton {
                            icon: "🔀";
                            size: 34px;
                            icon-size: 13px;
                            active: root.shuffle-on;
                            clicked => { root.toggle-shuffle(); }
                        }
                        IconButton {
                            icon: "⏮";
                            size: 36px;
                            icon-size: 15px;
                            clicked => { root.prev-track(); }
                        }
                        Rectangle {
                            width: 44px;
                            height: 44px;
                            border-radius: 22px;
                            background: pp-ta.has-hover ? #a78bfa : Theme.accent;
                            animate background { duration: 120ms; }
                            Text {
                                width: 100%;
                                height: 100%;
                                text: root.playing ? "⏸" : "▶";
                                color: #ffffff;
                                font-size: 16px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            pp-ta := TouchArea {
                                clicked => { root.play-pause(); }
                            }
                        }
                        IconButton {
                            icon: "⏭";
                            size: 36px;
                            icon-size: 15px;
                            clicked => { root.next-track(); }
                        }
                        Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: 17px;
                            background: rp-btn-ta.has-hover ? Theme.surface3 : transparent;
                            Text {
                                width: 100%;
                                height: 100%;
                                text: root.repeat-mode == 2 ? "🔂" : "🔁";
                                color: root.repeat-mode > 0 ? Theme.accent : Theme.text;
                                font-size: 13px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            rp-btn-ta := TouchArea {
                                clicked => { root.cycle-repeat(); }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;
                        Text {
                            text: root.position-text;
                            color: Theme.muted;
                            font-size: 10px;
                            width: 34px;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }
                        HSlider {
                            width: min(440px, root.width * 0.34);
                            value: root.progress;
                            changed(v) => { root.seek(v); }
                        }
                        Text {
                            text: root.duration-text;
                            color: Theme.muted;
                            font-size: 10px;
                            width: 34px;
                            vertical-alignment: center;
                        }
                    }
                }
                // ----- Right: queue + volume -----
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: "🎶";
                        tip: "Fila de reprodução";
                        active: root.queue-open;
                        clicked => { root.queue-open = !root.queue-open; }
                    }
                    Text {
                        text: root.volume == 0 ? "🔇" : "🔊";
                        font-size: 13px;
                        color: Theme.muted;
                        vertical-alignment: center;
                    }
                    HSlider {
                        y: (parent.height - self.height) / 2;
                        width: root.wide ? 110px : 70px;
                        value: root.volume;
                        fill: Theme.accent2;
                        changed(v) => { root.volume-changed(v); }
                    }
                }
            }
        }

    // ==================== Queue side panel (overlay) ====================
    if root.queue-open: Rectangle {
        x: root.width - 340px;
        y: 62px;
        width: 340px;
        height: root.height - 62px - 96px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.stroke;
        border-radius: 12px;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000090;
        VerticalLayout {
            padding: 14px;
            spacing: 8px;
            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: "Fila de Reprodução";
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 800;
                    vertical-alignment: center;
                }
                IconButton {
                    icon: "❌";
                    size: 30px;
                    icon-size: 11px;
                    clicked => { root.queue-open = false; }
                }
            }
            if root.queue.length == 0: Text {
                text: "A fila esta vazia.";
                color: Theme.muted;
                font-size: 12px;
            }
            ListView {
                for q[i] in root.queue: Rectangle {
                    height: 50px;
                    border-radius: 8px;
                    background: q.playing ? Theme.surface3 : (q-ta.has-hover ? Theme.surface2 : transparent);
                    q-ta := TouchArea {
                        clicked => { root.queue-play(i); }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 4px;
                        spacing: 8px;
                        Text {
                            text: q.playing ? "▶" : i + 1;
                            color: q.playing ? Theme.accent : Theme.muted;
                            font-size: 11px;
                            width: 20px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            Text {
                                text: q.title;
                                color: Theme.text;
                                font-size: 12px;
                                font-weight: 600;
                                overflow: elide;
                            }
                            Text {
                                text: q.artist;
                                color: Theme.muted;
                                font-size: 10px;
                                overflow: elide;
                            }
                        }
                        HorizontalLayout {
                            spacing: 0px;
                            alignment: end;
                            IconButton {
                                icon: "🔼";
                                size: 26px;
                                icon-size: 10px;
                                clicked => {
                                    if (i > 0) { root.queue-move(i, i - 1); }
                                }
                            }
                            IconButton {
                                icon: "🔽";
                                size: 26px;
                                icon-size: 10px;
                                clicked => {
                                    if (i < root.queue.length - 1) { root.queue-move(i, i + 1); }
                                }
                            }
                            IconButton {
                                icon: "❌";
                                size: 26px;
                                icon-size: 10px;
                                clicked => { root.queue-remove(i); }
                            }
                        }
                    }
                }
            }
        }
    }
}
